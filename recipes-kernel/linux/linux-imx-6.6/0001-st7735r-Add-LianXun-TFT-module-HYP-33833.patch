From 9360b7a4c8620d8f3527fd49b4b8065eacd81e17 Mon Sep 17 00:00:00 2001
From: Mario Schuknecht <mario.schuknecht@iris-sensing.com>
Date: Fri, 17 Apr 2026 08:22:32 +0200
Subject: [PATCH] st7735r: add LianXun LX096A0802 TFT module HYP-33833

Add support for LianXun LX096A0802 TFT controller module.
---
 drivers/gpu/drm/tiny/st7735r.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/gpu/drm/tiny/st7735r.c b/drivers/gpu/drm/tiny/st7735r.c
index 477eb36fbb70..be2b92bba2d9 100644
--- a/drivers/gpu/drm/tiny/st7735r.c
+++ b/drivers/gpu/drm/tiny/st7735r.c
@@ -91,7 +91,8 @@ static void st7735r_pipe_enable(struct drm_simple_display_pipe *pipe,
 	mipi_dbi_command(dbi, ST7735R_PWCTR4, 0x8a, 0x2a);
 	mipi_dbi_command(dbi, ST7735R_PWCTR5, 0x8a, 0xee);
 	mipi_dbi_command(dbi, ST7735R_VMCTR1, 0x0e);
 	mipi_dbi_command(dbi, MIPI_DCS_EXIT_INVERT_MODE);
+	dbidev->rotation = 90; /* quick & dirty hardcoded rotation */
 	switch (dbidev->rotation) {
 	default:
 		addr_mode = ST7735R_MX | ST7735R_MY;
@@ -136,6 +137,14 @@ static const struct drm_simple_display_pipe_funcs st7735r_pipe_funcs = {
 	DRM_MIPI_DBI_SIMPLE_DISPLAY_PIPE_FUNCS(st7735r_pipe_enable),
 };
 
+static const struct st7735r_cfg lx096a0802_cfg = {
+	.mode		= { DRM_SIMPLE_MODE(160, 80, 22, 11) },
+	.write_only	= true,
+	.top_offset	= 24,
+	.left_offset	= 0,
+	.rgb		= true,
+};
+
 static const struct st7735r_cfg jd_t18003_t01_cfg = {
 	.mode		= { DRM_SIMPLE_MODE(128, 160, 28, 35) },
 	/* Cannot read from Adafruit 1.8" display via SPI */
@@ -166,6 +175,7 @@ static const struct drm_driver st7735r_driver = {
 static const struct of_device_id st7735r_of_match[] = {
 	{ .compatible = "jianda,jd-t18003-t01", .data = &jd_t18003_t01_cfg },
 	{ .compatible = "okaya,rh128128t", .data = &rh128128t_cfg },
+	{ .compatible = "lianxun,lx096a0802", .data = &lx096a0802_cfg },
 	{ },
 };
 MODULE_DEVICE_TABLE(of, st7735r_of_match);
@@ -173,6 +183,7 @@ MODULE_DEVICE_TABLE(of, st7735r_of_match);
 static const struct spi_device_id st7735r_id[] = {
 	{ "jd-t18003-t01", (uintptr_t)&jd_t18003_t01_cfg },
 	{ "rh128128t", (uintptr_t)&rh128128t_cfg },
+	{ "lx096a0802", (uintptr_t)&lx096a0802_cfg },
 	{ },
 };
 MODULE_DEVICE_TABLE(spi, st7735r_id);
-- 
2.50.1

